WITH FINAL_REPORT AS (

SELECT

    a.USMD_CREQUEST                                   AS CR_NUMBER,

    '05'                                              AS TYPE_OF_CHANGE_REQUEST,

    a.USMD_CREQ_TEXT                                  AS DESCRIPTION_LONG_TEXT,

    a.USMD_CREATED_BY                                 AS CREATED_BY,

    PARSE_TIMESTAMP(
        '%Y%m%d%H%M%S',
        CAST(a.USMD_CREATED_AT AS STRING)
    )                                                 AS CREATED_DATE,

    a.USMD_RELEASED_BY                                AS RELEASED_BY,

    PARSE_TIMESTAMP(
        '%Y%m%d%H%M%S',
        CAST(a.USMD_RELEASED_AT AS STRING)
    )                                                 AS RELEASED_DATE,

    ROUND(

        TIMESTAMP_DIFF(

            PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_RELEASED_AT AS STRING)
            ),

            PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_CREATED_AT AS STRING)
            ),

            MINUTE

        ) / 60.0,

        2

    )                                                 AS OVERALL_TAT_HOURS,

    CASE

        WHEN ROUND(

            TIMESTAMP_DIFF(

                PARSE_TIMESTAMP(
                    '%Y%m%d%H%M%S',
                    CAST(a.USMD_RELEASED_AT AS STRING)
                ),

                PARSE_TIMESTAMP(
                    '%Y%m%d%H%M%S',
                    CAST(a.USMD_CREATED_AT AS STRING)
                ),

                HOUR

            ),

            2

        ) >= 24

        THEN CONCAT(

            CAST(

                FLOOR(

                    TIMESTAMP_DIFF(

                        PARSE_TIMESTAMP(
                            '%Y%m%d%H%M%S',
                            CAST(a.USMD_RELEASED_AT AS STRING)
                        ),

                        PARSE_TIMESTAMP(
                            '%Y%m%d%H%M%S',
                            CAST(a.USMD_CREATED_AT AS STRING)
                        ),

                        HOUR

                    ) / 24

                ) AS STRING

            ),

            ' Days'

        )

        ELSE CONCAT(

            CAST(

                ROUND(

                    TIMESTAMP_DIFF(

                        PARSE_TIMESTAMP(
                            '%Y%m%d%H%M%S',
                            CAST(a.USMD_RELEASED_AT AS STRING)
                        ),

                        PARSE_TIMESTAMP(
                            '%Y%m%d%H%M%S',
                            CAST(a.USMD_CREATED_AT AS STRING)
                        ),

                        MINUTE

                    ) / 60.0,

                    2

                ) AS STRING

            ),

            ' Hours'

        )

    END                                               AS OVERALL_TAT,

    b.USMD_VALUE                                      AS CHARACTERISTIC_VALUE,

    d.TOP_WI_ID                                       AS TOP_WI_ID,

    a.USMD_RELEASED_BY                                AS APPROVER_1_NAME,

    'MDG_APPROVAL'                                    AS APPROVER_1_DEPT,

    ROUND(

        TIMESTAMP_DIFF(

            PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_RELEASED_AT AS STRING)
            ),

            PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_CREATED_AT AS STRING)
            ),

            MINUTE

        ) / 60.0,

        2

    )                                                 AS APPROVER_1_TAT

FROM
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD120C` a

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` b
ON a.USMD_CREQUEST = b.USMD_CREQUEST

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD2400` d
ON a.USMD_CREQUEST = d.USMD_CREQUEST

WHERE
a.USMD_CREQ_STATUS = '05'

AND a.USMD_RELEASED_BY IS NOT NULL

AND a.USMD_RELEASED_AT IS NOT NULL

)

SELECT *
FROM FINAL_REPORT
LIMIT 200;
