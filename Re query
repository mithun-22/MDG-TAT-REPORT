WITH MAIN_DATA AS (

SELECT

    a.USMD_CREQUEST                                         AS CR_NUMBER,

    a.USMD_CREQ_STATUS                                      AS CREQ_STATUS_05,

    a.USMD_CREQ_TEXT                                        AS DESCRIPTION_LONG_TEXT,

    a.USMD_CREATED_BY                                       AS CREATED_BY,

    SAFE.PARSE_TIMESTAMP(
        '%Y%m%d%H%M%S',
        CAST(a.USMD_CREATED_AT AS STRING)
    )                                                       AS CREATED_DATE,

    COALESCE(
        a.USMD_RELEASED_BY,
        a.USMD_CHANGED_BY
    )                                                       AS RELEASED_BY,

    COALESCE(

        SAFE.PARSE_TIMESTAMP(
            '%Y%m%d%H%M%S',
            CAST(a.USMD_RELEASED_AT AS STRING)
        ),

        SAFE.PARSE_TIMESTAMP(
            '%Y%m%d%H%M%S',
            CAST(a.USMD_CHANGED_AT AS STRING)
        )

    )                                                       AS RELEASED_DATE,

    b.USMD_VALUE                                            AS CHARACTERISTIC_VALUE,

    c.TOP_WI_ID                                             AS TOP_WI_ID,

    w.WI_CREATOR                                            AS WORKFLOW_CREATOR,

    w.WI_AAGENT                                             AS WORKFLOW_AGENT,

    w.WI_CD                                                 AS WORKFLOW_CREATED_DATE,

    w.WI_CT                                                 AS WORKFLOW_COMPLETED_DATE

FROM
`sap_landing_zone.SAP_TRANSP_USMD120C` a

LEFT JOIN
`sap_landing_zone.SAP_TRANSP_USMD1213` b
ON a.USMD_CREQUEST = b.USMD_CREQUEST

LEFT JOIN
`sap_landing_zone.SAP_TRANSP_USMD2400` c
ON a.USMD_CREQUEST = c.USMD_CREQUEST

LEFT JOIN
`sap_landing_zone.SAP_TRANSP_SWWWIHEAD` w
ON c.TOP_WI_ID = w.WI_ID

WHERE
a.USMD_CREQ_STATUS = '0.5'

)

SELECT

    CR_NUMBER,

    CREQ_STATUS_05,

    DESCRIPTION_LONG_TEXT,

    CREATED_BY,

    CREATED_DATE,

    RELEASED_BY,

    RELEASED_DATE,

    ROUND(

        TIMESTAMP_DIFF(
            RELEASED_DATE,
            CREATED_DATE,
            HOUR
        ),

        2

    )                                                       AS OVERALL_TAT_HOURS,

    CHARACTERISTIC_VALUE,

    TOP_WI_ID,

    ----------------------------------------------------------------
    -- APPROVER 1
    ----------------------------------------------------------------

    RELEASED_BY                                             AS APPROVER_1_NAME,

    WORKFLOW_CREATOR                                        AS APPROVER_1_DEPT,

    ROUND(

        TIMESTAMP_DIFF(
            RELEASED_DATE,
            CREATED_DATE,
            HOUR
        ),

        2

    )                                                       AS APPROVER_1_TAT,

    ----------------------------------------------------------------
    -- APPROVER 2
    ----------------------------------------------------------------

    WORKFLOW_AGENT                                          AS APPROVER_2_NAME,

    WORKFLOW_CREATOR                                        AS APPROVER_2_DEPT,

    ROUND(

        TIMESTAMP_DIFF(
            WORKFLOW_COMPLETED_DATE,
            WORKFLOW_CREATED_DATE,
            HOUR
        ),

        2

    )                                                       AS APPROVER_2_TAT,

    ----------------------------------------------------------------
    -- APPROVER 3
    ----------------------------------------------------------------

    WORKFLOW_AGENT                                          AS APPROVER_3_NAME,

    WORKFLOW_CREATOR                                        AS APPROVER_3_DEPT,

    ROUND(

        TIMESTAMP_DIFF(
            WORKFLOW_COMPLETED_DATE,
            WORKFLOW_CREATED_DATE,
            HOUR
        ),

        2

    )                                                       AS APPROVER_3_TAT,

    ----------------------------------------------------------------
    -- APPROVER 4
    ----------------------------------------------------------------

    WORKFLOW_AGENT                                          AS APPROVER_4_NAME,

    WORKFLOW_CREATOR                                        AS APPROVER_4_DEPT,

    ROUND(

        TIMESTAMP_DIFF(
            WORKFLOW_COMPLETED_DATE,
            WORKFLOW_CREATED_DATE,
            HOUR
        ),

        2

    )                                                       AS APPROVER_4_TAT,

    ----------------------------------------------------------------
    -- APPROVER 5
    ----------------------------------------------------------------

    WORKFLOW_AGENT                                          AS APPROVER_5_NAME,

    WORKFLOW_CREATOR                                        AS APPROVER_5_DEPT,

    ROUND(

        TIMESTAMP_DIFF(
            WORKFLOW_COMPLETED_DATE,
            WORKFLOW_CREATED_DATE,
            HOUR
        ),

        2

    )                                                       AS APPROVER_5_TAT,

    ----------------------------------------------------------------
    -- APPROVER 6
    ----------------------------------------------------------------

    WORKFLOW_AGENT                                          AS APPROVER_6_NAME,

    WORKFLOW_CREATOR                                        AS APPROVER_6_DEPT,

    ROUND(

        TIMESTAMP_DIFF(
            WORKFLOW_COMPLETED_DATE,
            WORKFLOW_CREATED_DATE,
            HOUR
        ),

        2

    )                                                       AS APPROVER_6_TAT

FROM MAIN_DATA

WHERE
CREATED_DATE IS NOT NULL

ORDER BY
CREATED_DATE DESC

LIMIT 200;
