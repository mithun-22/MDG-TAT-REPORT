WITH BASE_DATA AS (

SELECT

    a.USMD_CREQUEST                                      AS CR_NUMBER,

    '05'                                                 AS CREQUEST_STATUS,

    a.USMD_CREQ_TEXT                                     AS DESCRIPTION_LONG_TEXT,

    a.USMD_CREATED_BY                                    AS CREATED_BY,

    PARSE_TIMESTAMP(
        '%Y%m%d%H%M%S',
        CAST(a.USMD_CREATED_AT AS STRING)
    )                                                    AS CREATED_DATE,

    a.USMD_RELEASED_BY                                   AS RELEASED_BY,

    PARSE_TIMESTAMP(
        '%Y%m%d%H%M%S',
        CAST(a.USMD_RELEASED_AT AS STRING)
    )                                                    AS RELEASED_DATE,

    ROUND(
        TIMESTAMP_DIFF(

            PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_RELEASED_AT AS STRING)
            ),

            PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_CREATED_AT AS STRING)
            ),

            MINUTE

        ) / 60.0,
        2
    )                                                    AS OVERALL_TAT_HOURS,

    CASE

        WHEN TIMESTAMP_DIFF(

            PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_RELEASED_AT AS STRING)
            ),

            PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_CREATED_AT AS STRING)
            ),

            HOUR

        ) >= 24

        THEN CONCAT(

            CAST(

                FLOOR(

                    TIMESTAMP_DIFF(

                        PARSE_TIMESTAMP(
                            '%Y%m%d%H%M%S',
                            CAST(a.USMD_RELEASED_AT AS STRING)
                        ),

                        PARSE_TIMESTAMP(
                            '%Y%m%d%H%M%S',
                            CAST(a.USMD_CREATED_AT AS STRING)
                        ),

                        HOUR

                    ) / 24

                ) AS STRING

            ),

            ' Days'

        )

        ELSE CONCAT(

            CAST(

                ROUND(

                    TIMESTAMP_DIFF(

                        PARSE_TIMESTAMP(
                            '%Y%m%d%H%M%S',
                            CAST(a.USMD_RELEASED_AT AS STRING)
                        ),

                        PARSE_TIMESTAMP(
                            '%Y%m%d%H%M%S',
                            CAST(a.USMD_CREATED_AT AS STRING)
                        ),

                        MINUTE

                    ) / 60.0,

                    2

                ) AS STRING

            ),

            ' Hours'

        )

    END                                                  AS OVERALL_TAT,

    b.USMD_VALUE                                         AS CHARACTERISTIC_VALUE,

    d.TOP_WI_ID                                          AS TOP_WI_ID

FROM
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD120C` a

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` b
ON a.USMD_CREQUEST = b.USMD_CREQUEST

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD2400` d
ON a.USMD_CREQUEST = d.USMD_CREQUEST

WHERE

a.USMD_CREQ_STATUS = '05'

AND a.USMD_RELEASED_BY IS NOT NULL

AND a.USMD_RELEASED_AT IS NOT NULL

),

FINAL_REPORT AS (

SELECT

    *,

    CASE
        WHEN RELEASED_BY = 'P00013281'
        THEN RELEASED_BY
        ELSE NULL
    END                                                  AS APPROVER_1_NAME,

    CASE
        WHEN RELEASED_BY = 'P00013281'
        THEN 'APPROVER_DEPARTMENT'
        ELSE NULL
    END                                                  AS APPROVER_1_DEPT,

    CASE
        WHEN RELEASED_BY = 'P00013281'
        THEN OVERALL_TAT
        ELSE NULL
    END                                                  AS APPROVER_1_TAT,

    CASE
        WHEN RELEASED_BY = 'P00002103'
        THEN RELEASED_BY
        ELSE NULL
    END                                                  AS APPROVER_2_NAME,

    CASE
        WHEN RELEASED_BY = 'P00002103'
        THEN 'APPROVER_DEPARTMENT'
        ELSE NULL
    END                                                  AS APPROVER_2_DEPT,

    CASE
        WHEN RELEASED_BY = 'P00002103'
        THEN OVERALL_TAT
        ELSE NULL
    END                                                  AS APPROVER_2_TAT,

    CASE
        WHEN RELEASED_BY = 'P00004567'
        THEN RELEASED_BY
        ELSE NULL
    END                                                  AS APPROVER_3_NAME,

    CASE
        WHEN RELEASED_BY = 'P00004567'
        THEN 'APPROVER_DEPARTMENT'
        ELSE NULL
    END                                                  AS APPROVER_3_DEPT,

    CASE
        WHEN RELEASED_BY = 'P00004567'
        THEN OVERALL_TAT
        ELSE NULL
    END                                                  AS APPROVER_3_TAT,

    CASE
        WHEN RELEASED_BY = 'P00007890'
        THEN RELEASED_BY
        ELSE NULL
    END                                                  AS APPROVER_4_NAME,

    CASE
        WHEN RELEASED_BY = 'P00007890'
        THEN 'APPROVER_DEPARTMENT'
        ELSE NULL
    END                                                  AS APPROVER_4_DEPT,

    CASE
        WHEN RELEASED_BY = 'P00007890'
        THEN OVERALL_TAT
        ELSE NULL
    END                                                  AS APPROVER_4_TAT,

    CASE
        WHEN RELEASED_BY = 'P00005678'
        THEN RELEASED_BY
        ELSE NULL
    END                                                  AS APPROVER_5_NAME,

    CASE
        WHEN RELEASED_BY = 'P00005678'
        THEN 'APPROVER_DEPARTMENT'
        ELSE NULL
    END                                                  AS APPROVER_5_DEPT,

    CASE
        WHEN RELEASED_BY = 'P00005678'
        THEN OVERALL_TAT
        ELSE NULL
    END                                                  AS APPROVER_5_TAT,

    CASE
        WHEN RELEASED_BY NOT IN (
            'P00013281',
            'P00002103',
            'P00004567',
            'P00007890',
            'P00005678'
        )
        THEN RELEASED_BY
        ELSE NULL
    END                                                  AS APPROVER_6_NAME,

    CASE
        WHEN RELEASED_BY NOT IN (
            'P00013281',
            'P00002103',
            'P00004567',
            'P00007890',
            'P00005678'
        )
        THEN 'APPROVER_DEPARTMENT'
        ELSE NULL
    END                                                  AS APPROVER_6_DEPT,

    CASE
        WHEN RELEASED_BY NOT IN (
            'P00013281',
            'P00002103',
            'P00004567',
            'P00007890',
            'P00005678'
        )
        THEN OVERALL_TAT
        ELSE NULL
    END                                                  AS APPROVER_6_TAT

FROM BASE_DATA

)

SELECT *
FROM FINAL_REPORT
LIMIT 100;
