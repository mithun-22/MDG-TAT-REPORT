WITH BASE_DATA AS (

SELECT

    ----------------------------------------------------------------
    -- CR DETAILS
    ----------------------------------------------------------------

    a.USMD_CREQUEST AS CR_NUMBER,

    a.USMD_CREQ_TYPE AS TYPE_OF_CHANGE_REQUEST,

    a.USMD_CREQ_TEXT AS DESCRIPTION_LONG_TEXT,

    ----------------------------------------------------------------
    -- CREATED DETAILS
    ----------------------------------------------------------------

    a.USMD_CREATED_BY AS CREATED_BY,

    SAFE.PARSE_TIMESTAMP(
        '%Y%m%d%H%M%S',
        CAST(a.USMD_CREATED_AT AS STRING)
    ) AS CREATED_DATE,

    ----------------------------------------------------------------
    -- RELEASE DETAILS
    ----------------------------------------------------------------

    COALESCE(
        a.USMD_RELEASED_BY,
        a.USMD_CHANGED_BY
    ) AS RELEASED_BY,

    COALESCE(

        SAFE.PARSE_TIMESTAMP(
            '%Y%m%d%H%M%S',
            CAST(a.USMD_RELEASED_AT AS STRING)
        ),

        SAFE.PARSE_TIMESTAMP(
            '%Y%m%d%H%M%S',
            CAST(a.USMD_CHANGED_AT AS STRING)
        )

    ) AS RELEASED_DATE,

    ----------------------------------------------------------------
    -- STATUS
    ----------------------------------------------------------------

    a.USMD_CREQ_STATUS AS CR_STATUS,

    ----------------------------------------------------------------
    -- MATERIAL DETAILS
    ----------------------------------------------------------------

    b.USMD_ENTITY,

    b.USMD_VALUE AS CHARACTERISTIC_VALUE,

    ----------------------------------------------------------------
    -- WORKFLOW
    ----------------------------------------------------------------

    c.TOP_WI_ID,

    ----------------------------------------------------------------
    -- APPROVER DETAILS
    ----------------------------------------------------------------

    log.METH_USER AS APPROVER_1_NAME,

    head.WI_CREATOR AS APPROVER_1_DEPT,

    ----------------------------------------------------------------
    -- OVERALL TAT
    ----------------------------------------------------------------

    TIMESTAMP_DIFF(

        COALESCE(

            SAFE.PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_RELEASED_AT AS STRING)
            ),

            SAFE.PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_CHANGED_AT AS STRING)
            )

        ),

        SAFE.PARSE_TIMESTAMP(
            '%Y%m%d%H%M%S',
            CAST(a.USMD_CREATED_AT AS STRING)
        ),

        HOUR

    ) AS OVERALL_TAT_HOURS,

    ----------------------------------------------------------------
    -- APPROVER TAT
    ----------------------------------------------------------------

    TIMESTAMP_DIFF(

        COALESCE(

            SAFE.PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_RELEASED_AT AS STRING)
            ),

            SAFE.PARSE_TIMESTAMP(
                '%Y%m%d%H%M%S',
                CAST(a.USMD_CHANGED_AT AS STRING)
            )

        ),

        SAFE.PARSE_TIMESTAMP(
            '%Y%m%d%H%M%S',
            CAST(a.USMD_CREATED_AT AS STRING)
        ),

        HOUR

    ) AS APPROVER_1_TAT

FROM
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD120C` a

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` b
ON a.USMD_CREQUEST = b.USMD_CREQUEST

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD2400` c
ON a.USMD_CREQUEST = c.USMD_CREQUEST

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_SWWWIHEAD` head
ON c.TOP_WI_ID = head.WI_ID

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_SWWLOGHIST` log
ON c.TOP_WI_ID = log.WI_ID

WHERE
a.USMD_CREQ_STATUS = '0.5'

)

SELECT

    ----------------------------------------------------------------
    -- MAIN REPORT
    ----------------------------------------------------------------

    CR_NUMBER,

    TYPE_OF_CHANGE_REQUEST,

    DESCRIPTION_LONG_TEXT,

    CREATED_BY,

    CREATED_DATE,

    RELEASED_BY,

    RELEASED_DATE,

    CONCAT(
        CAST(OVERALL_TAT_HOURS AS STRING),
        ' Hours'
    ) AS OVERALL_TAT,

    CHARACTERISTIC_VALUE,

    TOP_WI_ID,

    ----------------------------------------------------------------
    -- APPROVER 1
    ----------------------------------------------------------------

    APPROVER_1_NAME,

    APPROVER_1_DEPT,

    CONCAT(
        CAST(APPROVER_1_TAT AS STRING),
        ' Hours'
    ) AS APPROVER_1_TAT,

    ----------------------------------------------------------------
    -- PLACEHOLDERS
    ----------------------------------------------------------------

    NULL AS APPROVER_2_NAME,
    NULL AS APPROVER_2_DEPT,
    NULL AS APPROVER_2_TAT,

    NULL AS APPROVER_3_NAME,
    NULL AS APPROVER_3_DEPT,
    NULL AS APPROVER_3_TAT,

    NULL AS APPROVER_4_NAME,
    NULL AS APPROVER_4_DEPT,
    NULL AS APPROVER_4_TAT,

    NULL AS APPROVER_5_NAME,
    NULL AS APPROVER_5_DEPT,
    NULL AS APPROVER_5_TAT,

    NULL AS APPROVER_6_NAME,
    NULL AS APPROVER_6_DEPT,
    NULL AS APPROVER_6_TAT

FROM BASE_DATA

ORDER BY CREATED_DATE DESC

LIMIT 100;
