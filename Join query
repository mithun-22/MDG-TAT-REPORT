WITH base_data AS (

SELECT

    a.USMD_CREQUEST                                     AS CR_NUMBER,

    a.USMD_CREQ_TYPE                                    AS TYPE_OF_CHANGE_REQUEST,

    a.USMD_CREQ_TEXT                                    AS DESCRIPTION_LONG_TEXT,

    a.USMD_CREATED_BY                                   AS CREATED_BY,

    TIMESTAMP_SECONDS(CAST(a.USMD_CREATED_AT AS INT64)) AS CREATED_DATE,

    a.USMD_RELEASED_BY                                  AS RELEASED_BY,

    TIMESTAMP_SECONDS(CAST(a.USMD_RELEASED_AT AS INT64)) AS RELEASED_DATE,

    a.USMD_CREQ_STATUS,

    b.USMD_VALUE                                        AS CHARACTERISTIC_VALUE,

    c.TOP_WI_ID,

    h.WI_AAGENT                                         AS APPROVER_NAME,

    h.WI_CD                                              AS APPROVER_CREATED_DATE,

    h.WI_CT                                              AS APPROVER_COMPLETED_DATE

FROM
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD120C` a

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` b
ON a.USMD_CREQUEST = b.USMD_CREQUEST

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD2400` c
ON a.USMD_CREQUEST = c.USMD_CREQUEST

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_SWWWIHEAD` h
ON c.TOP_WI_ID = h.WI_ID

WHERE
    a.USMD_CREQ_STATUS = '05'
    AND b.USMD_ENTITY = 'MATERIAL'

),

approver_data AS (

SELECT

    *,

    ROW_NUMBER() OVER(
        PARTITION BY CR_NUMBER
        ORDER BY APPROVER_CREATED_DATE
    ) AS APPROVER_SEQ,

    TIMESTAMP_DIFF(
        APPROVER_COMPLETED_DATE,
        APPROVER_CREATED_DATE,
        HOUR
    ) AS APPROVER_TAT_HOURS

FROM base_data

)

SELECT

    CR_NUMBER,

    TYPE_OF_CHANGE_REQUEST,

    DESCRIPTION_LONG_TEXT,

    CREATED_BY,

    CREATED_DATE,

    RELEASED_BY,

    RELEASED_DATE,

    TIMESTAMP_DIFF(
        RELEASED_DATE,
        CREATED_DATE,
        HOUR
    ) AS OVERALL_TAT_HOURS,

    CHARACTERISTIC_VALUE,

    TOP_WI_ID,

    MAX(CASE WHEN APPROVER_SEQ = 1 THEN APPROVER_NAME END)
        AS APPROVER_1_NAME,

    MAX(CASE WHEN APPROVER_SEQ = 1 THEN APPROVER_TAT_HOURS END)
        AS APPROVER_1_TAT,

    MAX(CASE WHEN APPROVER_SEQ = 2 THEN APPROVER_NAME END)
        AS APPROVER_2_NAME,

    MAX(CASE WHEN APPROVER_SEQ = 2 THEN APPROVER_TAT_HOURS END)
        AS APPROVER_2_TAT,

    MAX(CASE WHEN APPROVER_SEQ = 3 THEN APPROVER_NAME END)
        AS APPROVER_3_NAME,

    MAX(CASE WHEN APPROVER_SEQ = 3 THEN APPROVER_TAT_HOURS END)
        AS APPROVER_3_TAT,

    MAX(CASE WHEN APPROVER_SEQ = 4 THEN APPROVER_NAME END)
        AS APPROVER_4_NAME,

    MAX(CASE WHEN APPROVER_SEQ = 4 THEN APPROVER_TAT_HOURS END)
        AS APPROVER_4_TAT,

    MAX(CASE WHEN APPROVER_SEQ = 5 THEN APPROVER_NAME END)
        AS APPROVER_5_NAME,

    MAX(CASE WHEN APPROVER_SEQ = 5 THEN APPROVER_TAT_HOURS END)
        AS APPROVER_5_TAT,

    MAX(CASE WHEN APPROVER_SEQ = 6 THEN APPROVER_NAME END)
        AS APPROVER_6_NAME,

    MAX(CASE WHEN APPROVER_SEQ = 6 THEN APPROVER_TAT_HOURS END)
        AS APPROVER_6_TAT

FROM approver_data

GROUP BY

    CR_NUMBER,
    TYPE_OF_CHANGE_REQUEST,
    DESCRIPTION_LONG_TEXT,
    CREATED_BY,
    CREATED_DATE,
    RELEASED_BY,
    RELEASED_DATE,
    CHARACTERISTIC_VALUE,
    TOP_WI_ID

ORDER BY CREATED_DATE DESC

LIMIT 100;
