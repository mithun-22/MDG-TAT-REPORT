Sub ExportTodaysEmails()

    Dim OutlookApp As Object
    Dim OutlookNS As Object
    Dim Folder As Object
    Dim Items As Object
    Dim Mail As Object
    Dim ws As Worksheet
    Dim i As Long
    Dim Row As Long
    Dim TodayDate As Date

    Set ws = ActiveSheet
    TodayDate = Date

    ' Headers
    ws.Cells.Clear

    ws.Cells(1, 1).Value = "Received Date"
    ws.Cells(1, 2).Value = "Sender"
    ws.Cells(1, 3).Value = "Subject"
    ws.Cells(1, 4).Value = "Email Body"

    Row = 2

    ' Connect to Outlook
    Set OutlookApp = CreateObject("Outlook.Application")
    Set OutlookNS = OutlookApp.GetNamespace("MAPI")

    ' Select your mailbox/folder
    Set Folder = OutlookNS.PickFolder

    If Folder Is Nothing Then
        MsgBox "No folder selected."
        Exit Sub
    End If

    Set Items = Folder.Items
    Items.Sort "[ReceivedTime]", True

    ' Process emails
    For i = 1 To Items.Count

        If TypeName(Items(i)) = "MailItem" Then

            Set Mail = Items(i)

            If DateValue(Mail.ReceivedTime) = TodayDate Then

                ws.Cells(Row, 1).Value = Mail.ReceivedTime
                ws.Cells(Row, 2).Value = Mail.SenderName
                ws.Cells(Row, 3).Value = Mail.Subject
                ws.Cells(Row, 4).Value = Mail.Body

                Row = Row + 1

            End If

        End If

    Next i

    ' Formatting
    ws.Columns("A:C").AutoFit
    ws.Columns("D").ColumnWidth = 80
    ws.Rows("1:1").Font.Bold = True

    MsgBox (Row - 2) & " emails exported successfully!"

End Sub
