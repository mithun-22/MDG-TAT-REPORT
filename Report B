WITH REPORT_B AS (

SELECT

    /* CR NUMBER FROM USMD120C */
    a.USMD_CREQUEST                                                AS CR_NUMBER,

    /* CHARACTERISTIC VALUE FROM USMD1213 */
    b.USMD_VALUE                                                   AS CHARACTERISTIC_VALUE,

    /* MATERIAL CODE FROM 1MDMD_000 */
    c._1MD_MMMATERIAL                                              AS MATERIAL_CODE,

    /* PLANT VALUE */
    CONCAT(
        RIGHT(
            CAST(c._1MD_MMMATERIAL AS STRING),
            4
        ),
        '-Plant'
    )                                                              AS PLANT,

    /* PRIMARY KEY = CR NUMBER + MATERIAL CODE + Plant */
    CONCAT(
        CAST(a.USMD_CREQUEST AS STRING),
        CAST(c._1MD_MMMATERIAL AS STRING),
        'Plant'
    )                                                              AS PRIMARY_KEY

FROM
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD120C` a

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` b
ON a.USMD_CREQUEST = b.USMD_CREQUEST

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_1MDMD_000` c
ON a.USMD_CREQUEST = c.USMDKMMATERIAL

WHERE

a.USMD_CREQ_STATUS = '05'

AND c._1MD_MMMATERIAL IS NOT NULL

)

SELECT *

FROM REPORT_B

LIMIT 100;
