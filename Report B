WITH REPORT_B AS (

SELECT DISTINCT

    /* CR NUMBER */
    a.USMD_CREQUEST                                            AS CR_NUMBER,

    /* CHARACTERISTIC VALUE */
    b.USMD_VALUE                                               AS CHARACTERISTIC_VALUE,

    /* MATERIAL CODE WITHOUT LEADING ZEROS */
    REGEXP_REPLACE(
        CAST(c._1MD_MMMATERIAL AS STRING),
        r'^0+',
        ''
    )                                                          AS MATERIAL_CODE,

    /* PLANT */
    CONCAT(
        RIGHT(
            REGEXP_REPLACE(
                CAST(c._1MD_MMMATERIAL AS STRING),
                r'^0+',
                ''
            ),
            4
        ),
        '-Plant'
    )                                                          AS PLANT,

    /* PRIMARY KEY */
    CONCAT(
        CAST(a.USMD_CREQUEST AS STRING),

        REGEXP_REPLACE(
            CAST(c._1MD_MMMATERIAL AS STRING),
            r'^0+',
            ''
        ),

        'Plant'
    )                                                          AS PRIMARY_KEY

FROM
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD120C` a

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` b
ON a.USMD_CREQUEST = b.USMD_CREQUEST

CROSS JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_1MDMD______00O` c

WHERE

a.USMD_CREQ_STATUS = '05'

AND c._1MD_MMMATERIAL IS NOT NULL

LIMIT 100

)

SELECT *

FROM REPORT_B;
