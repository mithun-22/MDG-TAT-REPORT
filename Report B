WITH REPORT_B AS (

SELECT

    a.USMD_CREQUEST                                            AS CR_NUMBER,

    b.USMD_VALUE                                               AS CHARACTERISTIC_VALUE,

    c.USMD_VALUE                                               AS MATERIAL,

    RIGHT(TRIM(b.USMD_VALUE), 5)                               AS PLANT,

    CONCAT(
        IFNULL(c.USMD_VALUE, ''),
        RIGHT(TRIM(b.USMD_VALUE), 5)
    )                                                          AS PRIMARY_KEY

FROM
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD120C` a

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` b
ON a.USMD_CREQUEST = b.USMD_CREQUEST

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` c
ON a.USMD_CREQUEST = c.USMD_CREQUEST

WHERE

a.USMD_CREQ_TYPE IN (
'ZMAT01',
'ZMAT02',
'E21',
'E23',
'O4',
'E06',
'M04',
'M02',
'NP01',
'NP03'
)

AND b.USMD_VALUE IS NOT NULL

)

SELECT *
FROM REPORT_B
LIMIT 100;
