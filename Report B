WITH BASE_DATA AS (

SELECT DISTINCT

    a.USMD_CREQUEST                                                AS CR_NUMBER,

    TRIM(b.USMD_VALUE)                                             AS CHARACTERISTIC_VALUE,

    LPAD(
        REGEXP_EXTRACT(TRIM(c.USMD_VALUE), r'[0-9]+'),
        10,
        '0'
    )                                                              AS MATERIAL,

    CONCAT(
        a.USMD_CREQUEST,
        LPAD(
            REGEXP_EXTRACT(TRIM(c.USMD_VALUE), r'[0-9]+'),
            10,
            '0'
        ),
        'Plant'
    )                                                              AS PLANT,

    CONCAT(
        a.USMD_CREQUEST,
        LPAD(
            REGEXP_EXTRACT(TRIM(c.USMD_VALUE), r'[0-9]+'),
            10,
            '0'
        )
    )                                                              AS PRIMARY_KEY

FROM
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD120C` a

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` b
ON a.USMD_CREQUEST = b.USMD_CREQUEST

LEFT JOIN
`drl-centrummdm-prod.sap_landing_zone.SAP_TRANSP_USMD1213` c
ON a.USMD_CREQUEST = c.USMD_CREQUEST

WHERE

a.USMD_CREQ_STATUS = '05'

AND a.USMD_CREQUEST IS NOT NULL

AND b.USMD_VALUE IS NOT NULL

AND c.USMD_VALUE IS NOT NULL

)

SELECT DISTINCT

CR_NUMBER,
CHARACTERISTIC_VALUE,
MATERIAL,
PLANT,
PRIMARY_KEY

FROM BASE_DATA

LIMIT 100;
